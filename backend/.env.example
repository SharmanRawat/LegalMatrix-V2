# LegalMatrix backend environment template.
# Copy to `backend/.env` (gitignored; NEVER commit real values):
#   cp .env.example .env
# The backend loads `.env` from this directory at import (real env vars win).

# --- Auth (REQUIRED before any shared demo/deployment) ---
# Generate: openssl rand -hex 48
LEGALMATRIX_AUTH_SECRET=change-me-to-a-long-random-hex-string

# --- Seed admin account (rotate before shared demos) ---
# Username the app does NOT print; password is never logged.
LEGALMATRIX_ADMIN_USERNAME=admin
LEGALMATRIX_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optionally shorten the auth-token TTL (hours, default 12)
# LEGALMATRIX_AUTH_TTL_HOURS=12