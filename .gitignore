# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
backend/venv/
backend/.venv/
.venv/

# docker runtime data (sqlite db + evidence photos + heatmaps are local-only)
backend/data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# evidence / runtime outputs (never commit - large + personal data)
**/evidence/
**/heatmaps/

# audit caches
/tmp/pipeline_audit_*.json
pipeline_audit_out/

# frontend build + deps (nested under frontend/)
frontend/node_modules/
frontend/.next/
frontend/.out/
frontend/build/

# sample product-label photos (large, copyrighted) — excluded
# Team: put your local label photos in ./images/ (gitignored) or point
# scripts at E:\SIH_installation_files\images (/mnt/e/SIH_installation_files/images under WSL).
images/
samples/
*.jpg.bak
/image36_2.jpg
backend/image36_2.jpg

# dev artifact
*.bak
*.tmp
*.log

# secrets - NEVER commit tokens, .env, or service keys
.env*
!.env.example
*.pem
*.key
secrets.json

# agent/browser test artifacts
.playwright-mcp/
.opencode/
