# Copy to .env (never commit .env itself). Dev defaults work without any file.
OLLAMA_HOST=http://localhost:11434
QWN_MODEL=qwen2.5vl:7b
FIELD_CLASSIFIER_MODEL=qwen2.5:3b
FIELD_CLASSIFIER_ENABLED=1
VLM_RESCUE_ENABLED=0
VLM_RESCUE_CONFIDENCE_THRESHOLD=55
OCR_ENGINE=auto
LEGALMATRIX_DATA_DIR=backend/data
# CHANGE IN PROD:
# LEGALMATRIX_AUTH_SECRET=generate-a-long-random-string
# ALLOWED_ORIGINS=http://localhost:3000
